            </asp:Label>
                        
            <div class="page-hero" id="PageHero" runat="server">
            <header>
                <div class="nav__bar">
                    <div class="nav__header">
                        <div class="nav__logo-ctn">
                            <asp:LinkButton ID="LinkButton_Logo" runat="server" OnClick="LinkButton_Logo_Click"><img class="nav__logo" src="../Content/images/site/logo.png"></asp:LinkButton>
                        </div>
                        <div class="nav__button-ctn">
                            <span class="icon-stack">
                                <img class="nav__mail-closed" src="../Content/images/site/mail-closed.png" alt="mail closed"/>
                                <a href="mailto:contact@netcreative.ca"><img class="nav__mail-open" src="../Content/images/site/mail-open.png" alt="mail open"/></a>
                            </span>
                            <a href="Tel:+14182269087"><img class="nav__mobile" src="../Content/images/site/mobile.png" alt="mobile phone" /></a>
                            <span class="icon-stack">
                                <asp:Image class="admin__button" ID="Image_Login" src="../Content/images/site/login.png" alt="login" runat="server" />
                                <a id="HyperLink_Login" runat="server" href="~/Admin/login.aspx"><img class="admin__login" src="../Content/images/site/login-smile.png" alt="login smile" /></a>
                            </span>
                        </div>
                        <div class="nav__slogan-ctn">
                            <span class="nav__slogan"><%: Global.Master_Slogan %></span>
                        </div>
                    </div>
                                                                        
                    <input type="checkbox" id="nav__toggle" class="nav__toggle">
                    <label for="nav__toggle" class="nav__toggle"><span class="nav__icon"></span></label>
                
                    <div class=nav__menu>
                        <img class="nav__logo" src="../Content/images/site/logo.png" alt="logo">
                        <a class="nav__links nav__links1 observer" href="/default.aspx"><%: Global.Master_Home %></a>
                        <a class="nav__links nav__links2 observer" href="/boutique.aspx"><%: Global.Master_Boutique %></a>
                        <a class="nav__links nav__links3 observer" href="/dutyfreeops.aspx"><%: Global.Master_DutyFreeOps %></a>
                        <a class="nav__links nav__links4 observer" href="/service.aspx"><%: Global.Master_Service %></a>
                        <a class="nav__links nav__links6 observer" href="/contact.aspx"><%: Global.Master_Contact %></a>
                        <a class="nav__links nav__links7 observer" ID="HyperLink_Language" runat="server"><%: Global.Master_LanguageToggle %></a>
                    </div>
                </div>
            </header>

                <div class="page-hero__content">
                    <span class="hero__eyebrow" id="Span_PageHeroEyebrow" runat="server" visible="false"></span>
                    <h1 class="hero__title" id="H1_PageHero" runat="server" visible="false"></h1>
                    <span class="hero__text" id="Span_PageHeroText" runat="server" visible="false"></span>
                    <a class="hero__cta" id="HyperLink_PageHeroCta" runat="server" visible="false"></a>
                </div>
            </div>

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>

            <footer>
                <div class="foot__container">
                    <div class="foot__nav">
                        <h3 class="foot__title"><%: Global.Master_Menu %></h3>
                        <div class=foot__menu>
                            <a class="foot__links" href="/default.aspx"><%: Global.Master_Home %></a>
                            <a class="foot__links" href="/boutique.aspx"><%: Global.Master_Boutique %></a>
                            <a class="foot__links" href="/dutyfreeops.aspx"><%: Global.Master_DutyFreeOps %></a>
                            <a class="foot__links" href="/service.aspx"><%: Global.Master_Service %></a>
                            <a class="foot__links" href="/contact.aspx"><%: Global.Master_Contact %></a>
                        </div>
                    </div>

                    <div class="foot__opening">
                        <h3 class="foot__title"><%: Global.Master_OpeningHours %></h3>
                        <div class="foot__opening-hours">
                            <asp:Label ID="Label_Monday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Tuesday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Wednesday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Thursday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Friday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Saturday" runat="server"></asp:Label>
                            <asp:Label ID="Label_Sunday" runat="server"></asp:Label>
                        </div>
                    </div>

                    <div class="foot__subscribe" data-network-error="<%: Global.Master_SubscribeNetworkError %>">
                        <h3 class="foot__title"><%: Global.Master_Newsletter %></h3>
                        <label class="foot__subscribe-text"><%: Global.Master_SubscribeText %></label>
                        <div class="foot__subscribe-input">
                            <asp:TextBox CssClass="tb__subscribe" ID="TextBox_Subscribe" runat="server"></asp:TextBox>
                            <button type="button" class="button button__orange subscribe__submit"><%: Global.Master_SubscribeButton %></button>
                        </div>
                    </div>

                    <div class="foot__map">
                        <h3 class="foot__title"><%: Global.Master_Contact %></h3>
                        <iframe class="foot__map-img" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2766.9242957962583!2d-70.60156668423464!3d46.09248639932049!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4cb9eb33245c96cd%3A0x8601cb36dba73455!2s2845%20208e%20Rue%2C%20Saint-Georges%2C%20QC%20G5Y%205B8!5e0!3m2!1sfr!2sca!4v1627955655628!5m2!1sfr!2sca" width="200" height="200" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>
            </footer>

            <div class="foot__bottom">
                <%: Global.Format(Global.Master_FooterText, DateTime.Now.Year) %>
                <asp:LinkButton class="foot__links" ID="LinkButton_Privacy" runat="server" OnClick="LinkButton_Privacy_Click"><%: Global.Master_PrivacyPolicy %></asp:LinkButton>
            </div>

            <asp:Panel class="cookie__panel" ID="Panel_CookieWarning" runat="server">
                <span class="cookie__label"><%: Global.Master_CookieWarningText %></span>
                <a class="cookie__ReadMore" href="/privacy.aspx"><%: Global.Master_CookieReadMore %></a>
                <button type="button" class="cookie__button"><%: Global.Master_CookieAccept %></button>
            </asp:Panel>

            <script src="../Content/js/animation.js"></script>
            <script src="../Content/js/observer.js"></script>
            <script src="../Content/js/cookie.js"></script>
            <script src="../Content/js/toast.js"></script>
            <script src="../Content/js/subscribe.js"></script>
        </form>
    </body>
</html>
